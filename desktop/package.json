{
  "name": "draftback-desktop",
  "version": "1.0.0-beta.6",
  "private": true,
  "description": "Draftback (回稿) desktop app: you mark up the draft, the AI revises it, the draft comes back",
  "main": "main.js",
  "author": "Draftback contributors",
  "license": "MIT",
  "scripts": {
    "start": "npm run build:vendor && electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "build:vendor": "node scripts/build-vendor.mjs",
    "dist:app": "npm run build:vendor && npm run build:helper && electron-builder --mac --arm64 --dir",
    "dist:dmg": "npm run build:vendor && npm run build:helper && electron-builder --mac dmg --arm64",
    "dist:zip": "npm run build:vendor && npm run build:helper && electron-builder --mac zip --arm64",
    "dist:beta": "npm run build:vendor && npm run build:helper && electron-builder --mac --arm64 --dir && electron-builder --mac dmg zip --arm64",
    "dist:win": "npm run build:vendor && electron-builder --win nsis --x64",
    "build:helper": "bash ../mac-sync/scripts/build.sh ${DRAFTBACK_HELPER_CONFIG:-Debug} || echo '同步辅助程序未构建(需要 Xcode 登录开发者账号),安装包里将不带同步'"
  },
  "devDependencies": {
    "@milkdown/crepe": "7.22.1",
    "@phosphor-icons/web": "2.1.2",
    "dompurify": "3.2.6",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1"
  },
  "build": {
    "appId": "app.draftback.mac",
    "productName": "Draftback",
    "afterPack": "scripts/after-pack.mjs",
    "asar": true,
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "open-files.js",
      "preload.js",
      "service.js",
      "user-data-migration.js",
      "export-docx.js",
      "dock-icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server.js",
        "to": "draftback-server/server.js"
      },
      {
        "from": "../mdreview.js",
        "to": "draftback-server/mdreview.js"
      },
      {
        "from": "../lib",
        "to": "draftback-server/lib"
      },
      {
        "from": "../static",
        "to": "draftback-server/static"
      }
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionAllowsInsecureHTTPSLoads": false
            },
            "localhost": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionAllowsInsecureHTTPSLoads": false
            }
          }
        },
        "LSHasLocalizedDisplayName": true,
        "CFBundleDisplayName": "Draftback"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "signIgnore": [
        "Helpers/Draftback Sync\\.app"
      ],
      "extraResources": [
        {
          "from": "build/localization/en.lproj",
          "to": "en.lproj"
        },
        {
          "from": "build/localization/zh-Hans.lproj",
          "to": "zh-Hans.lproj"
        },
        {
          "from": "build/localization/zh-Hans.lproj",
          "to": "zh_CN.lproj"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Draftback"
    },
    "dmg": {
      "sign": false
    },
    "extraFiles": [
      {
        "from": "../mac-sync/build/Draftback Sync.app",
        "to": "Helpers/Draftback Sync.app",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
